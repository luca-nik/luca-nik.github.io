---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Luca Nicoli — Cryptoeconomist, Research Scientist, Engineer' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Luca Nicoli — Blog" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href="/">Luca Nicoli</a>
        <nav>
          <a href="/case-studies">Case Studies</a>
          <a href="/publications">Publications</a>
          <a href="/blog">Blog</a>
          <a href="/Luca-Nicoli-CV.pdf">CV</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <a href="mailto:luca.nicoli.engineer@gmail.com">Email</a> ·
        <a href="https://github.com/luca-nik">GitHub</a> ·
        <a href="https://scholar.google.com/citations?hl=en&user=SsTwaqEAAAAJ">Google Scholar</a> ·
        <a href="https://www.linkedin.com/in/luca-nicoli">LinkedIn</a>
      </div>
    </footer>
  </body>
</html>
