---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const cases = (await getCollection('casestudies')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title="Luca Nicoli — Cryptoeconomist & Research Scientist">
  <div class="hero">
    <img src="/images/me.jpg" alt="Luca Nicoli" />
    <div>
      <h1>Luca Nicoli, PhD</h1>
      <p class="muted" style="margin-top:0;">Cryptoeconomist · Research Scientist · Engineer</p>
      <div class="chips">
        <a class="chip" href="mailto:luca.nicoli.engineer@gmail.com">Email</a>
        <a class="chip" href="https://github.com/luca-nik">GitHub</a>
        <a class="chip" href="https://scholar.google.com/citations?hl=en&user=SsTwaqEAAAAJ">Google Scholar</a>
        <a class="chip" href="https://www.linkedin.com/in/luca-nicoli">LinkedIn</a>
        <a class="chip" href="/Luca-Nicoli-CV.pdf">CV</a>
      </div>
    </div>
  </div>

  <p>
    Research scientist trained in Engineering Physics, with a focus on semiconductor
    nanotechnologies. After earning a PhD <em>cum laude</em> from Scuola Normale Superiore in
    Theoretical &amp; Computational Chemistry, he shifted to crypto working on MEV solver agents,
    optimal routing, and cryptoeconomic mechanism design. He is also co-founder and administrator
    of <a href="https://traenthub.com/">Traent Hub</a>, Pisa's technology and innovation hub.
  </p>

  <h2>Selected case studies</h2>
  {cases.map((c) => (
    <a class="card" href={`/case-studies/${c.id}`}>
      <div class="card-title">{c.data.title}</div>
      <div class="card-meta">{c.data.org} · {c.data.tags}</div>
      <p class="card-summary">{c.data.summary}</p>
    </a>
  ))}

  <h2>Latest posts</h2>
  <ul class="entry-list">
    {posts.map((p) => (
      <li>
        <a class="entry-title" href={`/blog/${p.id}`}>{p.data.title}</a>
        <div class="entry-meta">{fmt(p.data.date)}</div>
        <p class="small muted">{p.data.excerpt}</p>
      </li>
    ))}
  </ul>
  <p class="small"><a href="/blog">All posts →</a></p>

  <blockquote class="poem">
    Perso<br />
    dai sentieri che ho tracciato<br />
    prima ancora di averli percorsi.<br />
    Ed io, smarrito<br />
    mi trovo.
  </blockquote>
</Base>
